generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
}

enum CheckoutOrderStatus {
  PENDING
  PROCESSING
  FULFILLED
  REFUNDED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  events            Event[]
  checkoutOrders    CheckoutOrder[]
  ticketValidations Ticket[]        @relation("TicketValidator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String      @id @default(cuid())
  organizerId String
  status      EventStatus @default(DRAFT)

  tmdbMovieId Int
  title       String
  posterUrl   String?
  genres      String[] @default([])

  venue      String
  room       String
  startsAt   DateTime
  capacity   Int
  priceCents Int

  organizer      User            @relation(fields: [organizerId], references: [id])
  seats          EventSeat[]
  checkoutOrders CheckoutOrder[]
  tickets        Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

model EventSeat {
  id      String     @id @default(cuid())
  eventId String
  status  SeatStatus @default(AVAILABLE)

  row    String
  number Int
  label  String

  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]

  @@unique([eventId, label])
  @@index([eventId, status])
}

model CheckoutOrder {
  id      String              @id @default(cuid())
  userId  String
  eventId String
  status  CheckoutOrderStatus @default(PENDING)

  seatIds     String[]
  amountCents Int
  currency    String   @default("brl")

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  fulfilledAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
  tickets Ticket[]

  @@index([userId, createdAt])
  @@index([eventId, status])
}

model Ticket {
  id         String       @id @default(cuid())
  code       String       @unique
  shareToken String       @unique @default(uuid())
  status     TicketStatus @default(VALID)

  orderId String
  eventId String
  seatId  String

  checkedInAt   DateTime?
  checkedInById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order       CheckoutOrder @relation(fields: [orderId], references: [id])
  event       Event         @relation(fields: [eventId], references: [id])
  seat        EventSeat     @relation(fields: [seatId], references: [id])
  checkedInBy User?         @relation("TicketValidator", fields: [checkedInById], references: [id])

  @@unique([orderId, seatId])
  @@index([eventId, status])
  @@index([checkedInById, checkedInAt])
}
