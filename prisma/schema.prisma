generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String      @id @default(cuid())
  organizerId String
  status      EventStatus @default(DRAFT)

  tmdbMovieId Int
  title       String
  posterUrl   String?

  venue      String
  room       String
  startsAt   DateTime
  capacity   Int
  priceCents Int

  organizer User        @relation(fields: [organizerId], references: [id])
  seats     EventSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

model EventSeat {
  id      String     @id @default(cuid())
  eventId String
  status  SeatStatus @default(AVAILABLE)

  row    String
  number Int
  label  String

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, label])
  @@index([eventId, status])
}
