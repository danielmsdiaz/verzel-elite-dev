generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
}

enum CheckoutOrderStatus {
  PENDING
  PROCESSING
  FULFILLED
  REFUNDED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  events Event[]
  checkoutOrders CheckoutOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String      @id @default(cuid())
  organizerId String
  status      EventStatus @default(DRAFT)

  tmdbMovieId Int
  title       String
  posterUrl   String?
  genres      String[] @default([])

  venue      String
  room       String
  startsAt   DateTime
  capacity   Int
  priceCents Int

  organizer User        @relation(fields: [organizerId], references: [id])
  seats     EventSeat[]
  checkoutOrders CheckoutOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
}

model EventSeat {
  id      String     @id @default(cuid())
  eventId String
  status  SeatStatus @default(AVAILABLE)

  row    String
  number Int
  label  String

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, label])
  @@index([eventId, status])
}

model CheckoutOrder {
  id        String              @id @default(cuid())
  userId    String
  eventId   String
  status    CheckoutOrderStatus @default(PENDING)

  seatIds     String[]
  amountCents Int
  currency    String   @default("brl")

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId    String?

  fulfilledAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@index([userId, createdAt])
  @@index([eventId, status])
}
